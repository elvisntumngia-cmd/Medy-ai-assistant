{
  "name": "medy-assistant",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,demo -c blue,cyan \"npm:dev -w @medy/api\" \"npm:dev -w @medy/demo\"",
    "build": "npm run build -w @medy/shared && npm run build -w @medy/assistant-react && npm run build -w @medy/assistant-widget && npm run build -w @medy/api && npm run build -w @medy/demo",
    "typecheck": "tsc -b",
    "lint": "node node_modules/eslint/bin/eslint.js apps packages tests --ext .ts,.tsx",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"{apps,packages,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"{apps,packages,tests}/**/*.{ts,tsx,css}\"",
    "test": "vitest run apps/api/src packages/assistant-react/src packages/assistant-widget/src",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.7"
  }
}
