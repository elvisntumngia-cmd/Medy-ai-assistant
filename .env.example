PORT=4180
CLIENT_ORIGIN=http://localhost:5180
VITE_API_URL=http://localhost:4180/api
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_ENABLED=false
DEMO_MODE=false
MEDY_LEADS_FILE=
MEDY_ACTIONS_FILE=
MEDY_CONVERSATIONAL_LEADS_FILE=
DATABASE_URL=
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=true
CLIENT_RELATIONS_EMAIL=
EMAIL_PROVIDER=mock
SIMULATED_DELAY=false

# OpenAI is opt-in and blocked in production/Render. Copy to root .env.local for development.
AI_PROVIDER=deterministic
MEDY_LOCAL_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_INPUT_LENGTH=2000
AI_HISTORY_MESSAGES=10
AI_MAX_OUTPUT_TOKENS=450
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_REQUEST_BUDGET=100
AI_DAILY_TOKEN_BUDGET=250000
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.60

# Public editorial snapshot; leave empty for repository knowledge/editorial/store.json
MEDY_PUBLIC_KNOWLEDGE_FILE=
# Content-free per-request metrics; AI usage metadata remains enabled
MEDY_METRICS=false
# New consent-form records expire from API visibility; expired records are pruned on the next save
MEDY_LEAD_RETENTION_DAYS=30
